<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>br.com.jence</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>merlin-route-finder</name>

	<properties>
		<maven.compiler.release>21</maven.compiler.release>
		<!-- Os fontes tem acento (mensagens de erro, nomes de secao); sem isto o compilador
		     usaria o charset da maquina, que no Windows nao e UTF-8. -->
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<!-- Sobrescrito para vazio pelo profile "integracao". -->
		<excluded.test.groups>integracao</excluded.test.groups>
	</properties>

	<!-- Versoes do Jersey alinhadas pelo BOM, como no material. -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.glassfish.jersey</groupId>
				<artifactId>jersey-bom</artifactId>
				<version>4.0.3</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- Servidor HTTP do material: Jersey sobre o Grizzly, com o hk2 para injecao. -->
		<dependency>
			<groupId>org.glassfish.jersey.containers</groupId>
			<artifactId>jersey-container-grizzly2-http</artifactId>
		</dependency>
		<dependency>
			<groupId>org.glassfish.jersey.inject</groupId>
			<artifactId>jersey-hk2</artifactId>
		</dependency>
		<!-- JSON-B, como no material: converte objeto Java em JSON e vice-versa. -->
		<dependency>
			<groupId>org.glassfish.jersey.media</groupId>
			<artifactId>jersey-media-json-binding</artifactId>
		</dependency>
		<!-- Driver JDBC do Oracle, na versao do material. -->
		<dependency>
			<groupId>com.oracle.database.jdbc</groupId>
			<artifactId>ojdbc8</artifactId>
			<version>23.2.0.0</version>
		</dependency>
		<!-- Copia de objetos de dominio para DTOs, como no material. -->
		<dependency>
			<groupId>org.modelmapper</groupId>
			<artifactId>modelmapper</artifactId>
			<version>3.0.0</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.10.1</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<profiles>
		<!--
			Testes marcados com @Tag("integracao") rodam contra o Oracle e exigem credenciais.
			Ficam de fora da execucao padrao para que `mvnw test` passe em qualquer maquina;
			rodar com `mvnw test -Pintegracao` quando houver banco.
		-->
		<profile>
			<id>integracao</id>
			<properties>
				<excluded.test.groups></excluded.test.groups>
			</properties>
		</profile>
	</profiles>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.15.0</version>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.6</version>
				<configuration>
					<excludedGroups>${excluded.test.groups}</excludedGroups>
				</configuration>
			</plugin>
			<!--
			  Cobertura de testes. Sem medida, "temos testes" e uma afirmacao sem tamanho.

			  Nao ha limite minimo configurado de proposito: por ora o numero serve para
			  encontrar o que ninguem exercita, nao para reprovar a construcao.
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<executions>
					<execution>
						<id>preparar-agente</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>relatorio</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- `mvnw exec:java` sobe a aplicacao pela Main, como no material. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.5.0</version>
				<configuration>
					<mainClass>br.com.jence.backend.Main</mainClass>
				</configuration>
			</plugin>
			<!--
			  Um jar so, com as dependencias dentro, para o Dockerfile rodar com java -jar.
			  O ServicesResourceTransformer junta os META-INF/services das bibliotecas: sem ele,
			  o Jersey nao acha o JSON-B nem o hk2 dentro do jar.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.6.0</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>br.com.jence.backend.Main</mainClass>
								</transformer>
							</transformers>
							<filters>
								<!-- Assinaturas das bibliotecas deixam de valer dentro do jar unico. -->
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
